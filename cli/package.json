{
  "name": "accent-cli",
  "version": "0.19.0",
  "author": "Simon Prévost",
  "description": "Accent CLI",
  "bin": {
    "accent": "./bin/run.js"
  },
  "dependencies": {
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-help": "^7.0.4",
    "@oclif/plugin-not-found": "^4.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "@oclif/plugin-warn-if-update-available": "^4.0.3",
    "chalk": "^6.0.1",
    "decamelize": "^7.0.0",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@oclif/test": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "oclif": "^6.0.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".oclif.manifest.json",
    "/bin",
    "/lib"
  ],
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "accent",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version",
      "@oclif/plugin-warn-if-update-available"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mirego/accent.git"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "clean": "rimraf .oclif.manifest.json",
    "prepublishOnly": "npm run build && oclif readme && oclif manifest"
  },
  "types": "lib/index.d.ts"
}
