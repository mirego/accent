{
  "singleQuote": true,
  "bracketSpacing": false,
  "plugins": ["prettier-plugin-ember-template-tag"],
  "overrides": [
    {
      "files": "*.{js,ts,gjs,gts}",
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": "*.svg",
      "options": {
        "parser": "html"
      }
    }
  ]
}
