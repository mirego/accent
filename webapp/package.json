{
  "name": "accent-webapp",
  "version": "0.0.1",
  "description": "The new new Accent Web app",
  "private": true,
  "contributors": [
    "Charles Demers <cdemers@mirego.com>",
    "Simon Prévost <sprevost@mirego.com>",
    "Luc-Olivier Boulet <loboulet@mirego.com>"
  ],
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "type-check": "tsc",
    "build": "vite build",
    "build-dev": "vite build --watch --mode development --outDir ../priv/static/webapp",
    "build-production-inline": "vite build --outDir ../priv/static/webapp --emptyOutDir",
    "build-production": "vite build --outDir webapp-dist",
    "start": "vite",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "repository": "https://github.com/mirego/accent",
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "overrides": {
    "ember-cli-htmlbars": "7.0.1"
  },
  "dependencies": {
    "@apollo/client": "4.3.4",
    "@ember/string": "4.0.1",
    "@embroider/macros": "1.21.3",
    "@glimmer/tracking": "1.1.2",
    "color": "5.0.3",
    "cryptiles": "4.1.3",
    "date-fns": "4.4.0",
    "diff-match-patch": "1.0.5",
    "ember-auto-import": "2.13.1",
    "ember-autoresize-modifier": "0.10.0",
    "ember-basic-dropdown": "9.0.1",
    "ember-cli": "7.3.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-flash": "7.0.0",
    "ember-cli-htmlbars": "7.0.1",
    "ember-concurrency": "5.3.0",
    "ember-intl": "9.3.1",
    "ember-keyboard": "10.0.0",
    "ember-load-initializers": "3.0.1",
    "ember-modifier": "4.3.0",
    "ember-page-title": "9.0.3",
    "ember-power-select": "9.0.3",
    "ember-resolver": "13.2.0",
    "ember-source": "7.3.1",
    "emoji-picker-element": "1.29.1",
    "graphql": "17.0.2",
    "graphql-tag": "2.12.7",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "pell": "1.0.6",
    "raven-js": "3.27.2",
    "rxjs": "7.8.2",
    "simple-fmt": "0.1.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@ember-intl/vite": "2.2.2",
    "@ember/optional-features": "3.0.0",
    "@ember/render-modifiers": "4.0.0",
    "@ember/test-helpers": "5.7.0",
    "@embroider/compat": "^4.1.27",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.9",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/vite": "^1.7.15",
    "@glimmer/component": "2.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@svg-jar/plugin": "^0.2.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/markdown-it": "14.2.0",
    "@types/pell": "1.0.4",
    "@types/rsvp": "4.0.9",
    "babel-eslint": "10.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "babel-plugin-graphql-tag": "3.3.0",
    "decorator-transforms": "^2.4.0",
    "ember-qunit": "^9.2.0",
    "ember-route-template": "^1.0.3",
    "ember-scoped-css": "^3.5.2",
    "eslint-plugin-mirego": "^1.0.0",
    "pretender": "3.4.7",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
