{
  "name": "accent-webapp",
  "version": "0.0.1",
  "description": "The new new Accent Web app",
  "private": true,
  "contributors": [
    "Charles Demers <cdemers@mirego.com>",
    "Simon Prévost <sprevost@mirego.com>",
    "Luc-Olivier Boulet <loboulet@mirego.com>"
  ],
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "type-check": "tsc",
    "start": "vite",
    "build": "vite build --outDir ../priv/static/webapp --emptyOutDir",
    "build-dev": "vite build --watch --mode development --outDir ../priv/static/webapp --emptyOutDir",
    "build-production-inline": "vite build --mode production --outDir ../priv/static/webapp --emptyOutDir",
    "build-production": "vite build --mode production --outDir webapp-dist --emptyOutDir"
  },
  "repository": "https://github.com/mirego/accent",
  "engines": {
    "node": ">= 24.0.0"
  },
  "ember": {
    "edition": "octane"
  },
  "browserslist": [
    "last 2 Edge versions",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "dependencies": {
    "@apollo/client": "4.2.3",
    "@ember-intl/v1-compat": "1.2.0",
    "@ember/string": "^4.0.1",
    "@embroider/config-meta-loader": "1.0.0",
    "@embroider/legacy-inspector-support": "0.1.3",
    "@embroider/macros": "1.20.5",
    "@glimmer/tracking": "1.1.2",
    "color": "5.0.3",
    "cryptiles": "4.1.3",
    "date-fns": "4.4.0",
    "diff-match-patch": "1.0.5",
    "ember-autoresize-modifier": "0.10.0",
    "ember-basic-dropdown": "9.0.0",
    "ember-cli": "7.0.1",
    "ember-cli-babel": "8.3.1",
    "ember-cli-content-security-policy": "2.0.3",
    "ember-cli-flash": "7.0.0",
    "ember-cli-htmlbars": "7.0.1",
    "ember-concurrency": "5.2.0",
    "ember-inline-svg": "1.0.1",
    "ember-intl": "8.2.8",
    "ember-keyboard": "9.0.4",
    "ember-load-initializers": "3.0.1",
    "ember-modifier": "4.3.0",
    "ember-power-select": "9.0.0",
    "ember-resolver": "13.2.0",
    "ember-source": "7.1.0",
    "emoji-picker-element": "1.29.1",
    "graphql": "17.0.1",
    "graphql-tag": "2.12.7",
    "highlight.js": "11.11.1",
    "markdown-it": "14.2.0",
    "pell": "1.0.6",
    "raven-js": "3.27.2",
    "rxjs": "7.8.2",
    "simple-fmt": "0.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@ember/optional-features": "3.0.0",
    "@ember/render-modifiers": "4.0.0",
    "@ember/test-helpers": "5.4.3",
    "@embroider/compat": "4.1.21",
    "@embroider/core": "4.6.2",
    "@embroider/vite": "1.7.8",
    "@glimmer/component": "2.1.1",
    "@rollup/plugin-babel": "7.1.0",
    "@types/diff": "7.0.2",
    "@types/diff-match-patch": "^1.0.35",
    "@types/markdown-it": "14.1.2",
    "@types/pell": "1.0.4",
    "@types/rsvp": "4.0.9",
    "autoprefixer": "10.5.2",
    "babel-eslint": "10.1.0",
    "babel-plugin-ember-template-compilation": "4.0.0",
    "babel-plugin-graphql-tag": "3.3.0",
    "decorator-transforms": "2.4.0",
    "ember-native-dom-helpers": "0.7.0",
    "ember-qunit": "9.0.4",
    "ember-scoped-css": "^2.2.2",
    "eslint-plugin-mirego": "^1.0.0",
    "postcss": "8.5.16",
    "pretender": "3.4.7",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
