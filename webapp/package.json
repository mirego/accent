  "scripts": {
    "type-check": "tsc",
    "build": "ember build --output-path=../priv/static/webapp",
    "build-dev": "ember build --watch --output-path=../priv/static/webapp",
    "build-production-inline": "ember build --environment=production --output-path=../priv/static/webapp",
    "build-production": "ember build --environment=production --output-path=webapp-dist"
  },
  "repository": "https://github.com/mirego/accent",
  "engines": {
    "node": ">= 21.6.0"
  },
  "ember": {
    "edition": "octane"
  },
