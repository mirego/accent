<li class='translation-comments-subscriptions-item {{if this.isCurrentUser "currentUser"}}'>
  <input type='checkbox' checked={{this.isSubscribed}} class='checkbox' {{on 'change' (fn this.toggleSubscription)}} />

  <span class='user'>
    {{@collaborator.user.fullname}}

    <span class='user-email'>
      {{@collaborator.email}}
    </span>
  </span>
</li>