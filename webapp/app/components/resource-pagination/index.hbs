<div class='resource-pagination'>
  {{#if this.showPagination}}
    <button disabled={{this.disabledPrevious}} class='button button--white button--filled button--iconOnly' {{on 'click' (fn this.goToPreviousPage)}}>
      {{inline-svg 'assets/chevron-left.svg' class='button-icon'}}
    </button>

    <span class='label local-label'>
      <span class='label-number'>
        {{@meta.currentPage}}
      </span>
      /
      <span class='label-number'>
        {{@meta.totalPages}}
      </span>
    </span>

    <button disabled={{this.disabledNext}} class='button button--white button--filled button--iconOnly' {{on 'click' (fn this.goToNextPage)}}>
      {{inline-svg 'assets/chevron-right.svg' class='button-icon'}}
    </button>
  {{/if}}
</div>