<button {{on 'click' (fn this.togglePicker)}} ...attributes>
  <div>
    {{yield}}
  </div>
</button>

{{#if this.destinationElement}}
  {{#if this.picker}}
    {{#in-element this.destinationElement}}
      <div class='wrapper' {{on-key 'Escape' this.togglePicker}}>
        <div role='button' class='overlay' {{on 'click' (fn this.togglePicker)}}></div>
        <div role='dialog' class='container'>
          {{this.picker}}
        </div>
      </div>
    {{/in-element}}
  {{/if}}
{{/if}}
