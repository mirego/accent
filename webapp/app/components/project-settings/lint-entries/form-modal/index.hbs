<AccModal @onClose={{@onClose}} @small={{true}}>
  <div class='wrapper'>
    <button type='button' class='closeButton' {{on 'click' @onClose}}>
      {{inline-svg '/assets/x.svg' class=(scoped-class 'closeButton-icon')}}
    </button>

    <strong class='title'>{{this.title}}</strong>

    <label class='field'>
      <span class='label'>{{t 'components.project_settings.lint_entries.type_label'}}</span>
      <AccSelect @customSelect={{true}} @options={{this.typeOptions}} @selected={{this.selectedType}} @onchange={{this.setType}} />
    </label>

    {{#unless this.isSpellcheckRule}}
      <label class='field'>
        <span class='label'>{{t 'components.project_settings.lint_entries.checks_label'}}</span>
        <AccSelect @multi={{true}} @options={{this.checkOptions}} @selected={{this.selectedChecks}} @onchange={{this.setChecks}} />
      </label>
    {{/unless}}

    {{#if this.showValueField}}
      <div class='field'>
        <span class='labelRow'>
          <span class='label'>{{this.valueLabel}}</span>
          {{#if this.isSpellcheckRule}}
            <a href='https://community.languagetool.org/rule/list' target='_blank' rel='noopener noreferrer' class='labelLink'>
              {{t 'components.project_settings.lint_entries.language_tool_rules_link'}}
            </a>
          {{/if}}
        </span>
        <input type='text' value={{this.value}} class='textInput' {{on 'input' this.setValue}} />
      </div>
    {{/if}}

    <div class='actions'>
      {{#if this.isEditMode}}
        <AsyncButton @onClick={{perform this.delete}} @loading={{this.delete.isRunning}} class='button button--red button--filled'>
          {{t 'components.project_settings.lint_entries.delete_button'}}
        </AsyncButton>
      {{/if}}

      <AsyncButton @onClick={{perform this.save}} @loading={{this.save.isRunning}} class='button button--filled'>
        {{t 'components.project_settings.lint_entries.save_button'}}
      </AsyncButton>
    </div>
  </div>
</AccModal>