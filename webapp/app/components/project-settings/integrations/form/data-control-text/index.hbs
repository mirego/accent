<div class='data-control {{if @error "error-control"}}'>
  <label class='data-title'>
    {{@label}}

    {{#if @helpLinkTitle}}
      <a target='_blank' rel='noopener noreferrer' href={{@helpLinkHref}} class='data-title-help'>
        {{@helpLinkTitle}}
      </a>
    {{/if}}
  </label>

  <input placeholder={{@placeholder}} value={{@value}} class='textInput' {{on 'keyup' (fn @onChange)}} />
</div>