<div class='projectId-{{@project.id}} project'>
  {{#if @project.logo}}
    <span class='projectLogo'>
      <ProjectLogo @logo={{@project.logo}} />
    </span>
  {{/if}}

  <span data-test-project-name class='projectName'>
    {{@project.name}}
  </span>
  <style>
    {{{this.colors}}}
  </style>
</div>
