{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es2020",
    "allowJs": false,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmitOnError": false,
    "noEmit": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "baseUrl": ".",
    "module": "es6",
    "lib": [
      "dom",
      "es2021",
      "esnext.asynciterable"
    ],
    "paths": {
      "accent-webapp/tests/*": [
        "tests/*"
      ],
      "accent-webapp/*": [
        "app/*"
      ],
      "*": [
        "types/*"
      ]
    }
  },
  "include": [
    "node_modules/ember-chai-dom-helpers",
    "app/**/*",
    "tests/**/*",
    "types/**/*"
  ]
}
