{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es2020",
    "allowJs": false,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmitOnError": false,
    "noEmit": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "esnext",
    "lib": [
      "dom",
      "es2021",
      "esnext.asynciterable"
    ],
    "paths": {
      "accent-webapp/tests/*": [
        "./tests/*"
      ],
      "accent-webapp/*": [
        "./app/*"
      ],
      "*": [
        "./types/*"
      ]
    },
    "types": [
      "@embroider/core/virtual",
      "@svg-jar/plugin/client/ember",
      "@ember-intl/vite/virtual"
    ]
  },
  "include": [
    "node_modules/ember-chai-dom-helpers",
    "app/**/*",
    "tests/**/*",
    "types/**/*"
  ]
}
